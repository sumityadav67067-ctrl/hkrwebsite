# Server Port & Host Configuration
# Set PORT to your desired port (e.g. 25595 for VPS, 3000 for local preview)
PORT=3000
HOST=0.0.0.0

# Optional Desired Deployment Port displayed in config exports
DESIRED_PORT=25595

# Creator Configuration (4 core inputs)
CHANNEL_NAME="HkR PlayZ"
YOUTUBE_CHANNEL_URL="https://www.youtube.com/@hkrplayz"
DISCORD_INVITE_URL="https://discord.gg/WP5g3uehWd"

# YouTube Data API v3 Key (keep strictly server-side; optional public feed fallback if omitted)
YOUTUBE_API_KEY=""

# Gemini AI API Key for automatic niche classification & adaptive branding (server-side only)
GEMINI_API_KEY=""

# Admin Authentication Secret & Initial Password (optional; if omitted, create admin via /admin UI)
SESSION_SECRET=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Background Refresh Intervals (in milliseconds) & Cache TTL
CACHE_TTL=300000
SUBSCRIBER_REFRESH_INTERVAL=300000
VIDEO_REFRESH_INTERVAL=600000
LIVE_REFRESH_INTERVAL=120000

# Application URL for canonical SEO tags and sitemap.xml
APP_URL="http://localhost:3000"
